NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_development_key
CLERK_SECRET_KEY=sk_test_replace_with_your_development_key
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Neon Postgres (use the POOLED connection string from the Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Admin login credentials: configure privately in .env.local and Vercel Environment Variables
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_long_unique_password
ADMIN_SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
